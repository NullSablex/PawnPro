{
  "name": "pawnpro",
  "displayName": "PawnPro",
  "description": "%text.description%",
  "version": "3.5.0",
  "publisher": "NullSablex",
  "type": "module",
  "license": "SEE LICENSE IN LICENSE.md",
  "engines": {
    "vscode": "^1.106.0"
  },
  "platforms": [
    "linux-x64",
    "linux-arm64",
    "win32-x64",
    "darwin-x64",
    "darwin-arm64"
  ],
  "categories": [
    "Programming Languages",
    "Linters"
  ],
  "keywords": [
    "pawn",
    "sa-mp",
    "samp",
    "gta",
    "pwn",
    "server",
    "rcon"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "bugs": {
    "url": "https://github.com/NullSablex/PawnPro/issues"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/NullSablex/PawnPro"
  },
  "icon": "images/logo.png",
  "engineVersion": "1.3.0",
  "engineRepository": "https://github.com/NullSablex/PawnPro-Engine",
  "debuggerVersion": "0.1.0",
  "debuggerRepository": "https://github.com/NullSablex/PawnPro-Debugger",
  "author": {
    "name": "NullSablex",
    "url": "https://github.com/NullSablex"
  },
  "main": "./out/editor/extension.js",
  "l10n": "./l10n",
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "pawnpro",
          "title": "PawnPro",
          "icon": "images/icon.svg"
        }
      ]
    },
    "views": {
      "pawnpro": [
        {
          "id": "pawnpro.includesView",
          "name": "Includes",
          "icon": "symbol-method"
        },
        {
          "id": "pawnpro.serverView",
          "name": "Servidor",
          "icon": "symbol-method",
          "type": "webview"
        }
      ]
    },
    "keybindings": [
      {
        "command": "pawnpro.compileCurrent",
        "key": "ctrl+alt+b",
        "when": "editorLangId == pawn && editorTextFocus"
      },
      {
        "command": "editor.action.formatSelection",
        "key": "ctrl+k ctrl+f",
        "when": "editorLangId == pawn && editorTextFocus && editorHasSelection && !editorReadonly"
      }
    ],
    "snippets": [
      {
        "language": "pawn",
        "path": "./snippets/pawn.json"
      }
    ],
    "grammars": [
      {
        "language": "pawn",
        "scopeName": "source.pawn",
        "path": "./syntaxes/pawn.tmLanguage.json"
      },
      {
        "language": "pawnpro-namelist",
        "scopeName": "source.pawnpro-namelist",
        "path": "./syntaxes/namelist.tmLanguage.json"
      },
      {
        "language": "toml",
        "scopeName": "source.toml",
        "path": "./syntaxes/toml.tmLanguage.json"
      }
    ],
    "semanticTokenScopes": [
      {
        "language": "pawn",
        "scopes": {
          "function": [
            "support.function.pawn"
          ]
        }
      },
      {
        "scopes": {
          "tomlArrayKey": [
            "support.type.property-name.array.toml"
          ],
          "tomlTableKey": [
            "support.type.property-name.table.toml"
          ]
        }
      }
    ],
    "languages": [
      {
        "id": "pawn",
        "aliases": [
          "PAWN",
          "pawn"
        ],
        "extensions": [
          ".pwn",
          ".inc",
          ".p",
          ".pawn"
        ],
        "configuration": "./language-configuration.json"
      },
      {
        "id": "pawnpro-namelist",
        "aliases": [
          "PawnPro Name List"
        ],
        "extensions": [
          ".ban",
          ".allow"
        ],
        "configuration": "./namelist-language-configuration.json"
      },
      {
        "id": "toml",
        "aliases": [
          "TOML"
        ],
        "extensions": [
          ".toml"
        ],
        "filenames": [
          "package.lock"
        ],
        "configuration": "./toml-language-configuration.json"
      }
    ],
    "commands": [
      {
        "command": "pawnpro.compileCurrent",
        "title": "%command.compile%"
      },
      {
        "command": "pawnpro.detectCompiler",
        "title": "%command.detect%"
      },
      {
        "command": "pawnpro.applySyntaxScheme",
        "title": "%command.applySyntaxScheme%"
      },
      {
        "command": "pawnpro.resetSyntaxScheme",
        "title": "%command.resetSyntaxScheme%"
      },
      {
        "command": "pawnpro.server.start",
        "title": "%command.server.start%",
        "icon": "$(debug-start)"
      },
      {
        "command": "pawnpro.server.stop",
        "title": "%command.server.stop%",
        "icon": "$(debug-stop)"
      },
      {
        "command": "pawnpro.server.restart",
        "title": "%command.server.restart%",
        "icon": "$(debug-restart)"
      },
      {
        "command": "pawnpro.server.show",
        "title": "%command.server.show%",
        "icon": "$(terminal)"
      },
      {
        "command": "pawnpro.server.showLog",
        "title": "%command.server.showLog%",
        "icon": "$(output)"
      },
      {
        "command": "pawnpro.clearEngineCache",
        "title": "%command.clearEngineCache%"
      },
      {
        "command": "pawnpro.recoverConfig",
        "title": "%command.recoverConfig%"
      },
      {
        "command": "pawnpro.whatsNew",
        "title": "%command.whatsNew%"
      },
      {
        "command": "pawnpro.help",
        "title": "%command.help%"
      },
      {
        "command": "pawnpro.newScript",
        "title": "%command.newScript%"
      },
      {
        "command": "pawnpro.openSettings",
        "title": "%command.openSettings%"
      },
      {
        "command": "pawnpro.openStore",
        "title": "%command.openStore%"
      }
    ],
    "configurationDefaults": {
      "[pawn]": {
        "files.encoding": "windows1252"
      }
    },
    "breakpoints": [
      {
        "language": "pawn"
      }
    ],
    "debuggers": [
      {
        "type": "pawn",
        "label": "PawnPro Debugger",
        "languages": [
          "pawn"
        ],
        "configurationAttributes": {
          "launch": {
            "required": [
              "program"
            ],
            "properties": {
              "program": {
                "type": "string",
                "description": "%debug.program%",
                "default": "${workspaceFolder}/gamemodes/${command:AskForProgramName}.amx"
              },
              "server": {
                "type": "string",
                "description": "%debug.server%"
              },
              "cwd": {
                "type": "string",
                "description": "%debug.cwd%",
                "default": "${workspaceFolder}"
              },
              "session": {
                "type": "string",
                "description": "%debug.session%"
              },
              "stopOnEntry": {
                "type": "boolean",
                "description": "%debug.stopOnEntry%",
                "default": false
              }
            }
          }
        },
        "initialConfigurations": [
          {
            "type": "pawn",
            "request": "launch",
            "name": "Depurar script Pawn (PawnPro)",
            "program": "${workspaceFolder}/gamemodes/main.amx",
            "cwd": "${workspaceFolder}"
          }
        ],
        "configurationSnippets": [
          {
            "label": "PawnPro: Depurar script Pawn",
            "description": "Depura um script Pawn (gamemode, filterscript ou outro .amx) no servidor local, compilado com -d3.",
            "body": {
              "type": "pawn",
              "request": "launch",
              "name": "Depurar script Pawn (PawnPro)",
              "program": "^\"\\${workspaceFolder}/gamemodes/main.amx\"",
              "cwd": "^\"\\${workspaceFolder}\""
            }
          }
        ]
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "pawnpro.server.start",
          "when": "view == pawnpro.serverView && !pawnpro.server.running",
          "group": "navigation"
        },
        {
          "command": "pawnpro.server.stop",
          "when": "view == pawnpro.serverView && pawnpro.server.running",
          "group": "navigation"
        },
        {
          "command": "pawnpro.server.restart",
          "when": "view == pawnpro.serverView && pawnpro.server.running",
          "group": "navigation@1"
        },
        {
          "command": "pawnpro.server.show",
          "when": "view == pawnpro.serverView",
          "group": "navigation@2"
        },
        {
          "command": "pawnpro.server.showLog",
          "when": "view == pawnpro.serverView && pawnpro.server.running",
          "group": "navigation@3"
        },
        {
          "command": "pawnpro.server.start",
          "when": "view == pawnpro.serverView.explorer && !pawnpro.server.running",
          "group": "navigation"
        },
        {
          "command": "pawnpro.server.stop",
          "when": "view == pawnpro.serverView.explorer && pawnpro.server.running",
          "group": "navigation"
        },
        {
          "command": "pawnpro.server.restart",
          "when": "view == pawnpro.serverView.explorer && pawnpro.server.running",
          "group": "navigation@1"
        },
        {
          "command": "pawnpro.server.show",
          "when": "view == pawnpro.serverView.explorer",
          "group": "navigation@2"
        },
        {
          "command": "pawnpro.server.showLog",
          "when": "view == pawnpro.serverView.explorer && pawnpro.server.running",
          "group": "navigation@3"
        }
      ],
      "commandPalette": [
        {
          "command": "pawnpro.server.start",
          "when": "true"
        },
        {
          "command": "pawnpro.server.stop",
          "when": "true"
        },
        {
          "command": "pawnpro.server.restart",
          "when": "true"
        },
        {
          "command": "pawnpro.server.show",
          "when": "true"
        },
        {
          "command": "pawnpro.server.showLog",
          "when": "true"
        }
      ]
    }
  },
  "scripts": {
    "compile": "tsc --noEmit -p .",
    "bundle": "node scripts/bundle.mjs",
    "bundle:dev": "node scripts/bundle.mjs --dev",
    "vscode:prepublish": "npm run bundle",
    "watch": "node scripts/bundle.mjs --watch",
    "package": "npm run package:full",
    "package:full": "npm run bundle && npx @vscode/vsce package --no-dependencies --no-yarn && node scripts/repack-vsix.js",
    "package:pre": "npm run bundle && npx @vscode/vsce package --pre-release --no-dependencies --no-yarn && node scripts/repack-vsix.js"
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "@types/vscode": "1.106.0",
    "@vscode/l10n-dev": "^0.0.35",
    "@vscode/vsce": "^3.9.2",
    "esbuild": "^0.28.1",
    "jszip": "^3.10.1",
    "typescript": "^7.0.2"
  },
  "dependencies": {
    "iconv-lite": "^0.7.3",
    "vscode-languageclient": "^10.1.0"
  },
  "overrides": {
    "minimatch": "10.2.3",
    "qs": "6.15.2",
    "ajv": "8.18.0",
    "markdown-it": "14.2.0",
    "underscore": "1.13.8"
  },
  "engineChecksums": {
    "pawnpro-engine-linux-x64": "ce0835c9743f0e20f305ed6be36b641c3af073db660893190f77c027bfe3b6cf",
    "pawnpro-engine-linux-arm64": "883896ecac93f2333cf7203571768e8212525d60155001456d1dc61e4103ae28",
    "pawnpro-engine-win32-x64.exe": "040dda1f08d4491de08324e9c0cc75830e76074961b771ea37b9ede3778bb855",
    "pawnpro-engine-darwin-x64": "5525fad77153d11b34a2aebb6031b6b1189e42844d1265dc2b2d3be9e4812833",
    "pawnpro-engine-darwin-arm64": "14b3452babc6c49f3f2ee5d0080ca02a0d39b640af582647406da280aa978316"
  },
  "debuggerChecksums": {
    "pawnpro-dap-adapter-linux-x64": "b504e2abf410423538eba394b4c4ac3b1fc2e8ba475ea247d8f0471900d09eed",
    "pawnpro-dap-adapter-linux-arm64": "f239f1319c0a6dad353978bf8a6f897f20b26ec8de9408a07baa2185b8066ec2",
    "pawnpro-dap-adapter-win32-x64.exe": "04b4b2ea785b45b8b2ab7974f3689bf2e0b5c6edaf247ae2f975165bfcc76d10",
    "pawnpro-dap-adapter-darwin-x64": "07d11df11a819e37cc2abbfd0a4d96318d398f4d5b064ff7aad7f3604b1adada",
    "pawnpro-dap-adapter-darwin-arm64": "84bcc2376bdef1a1da8d57c9a4c1f284cd512bacb04fab818fb7adc954ed1ae7"
  }
}
