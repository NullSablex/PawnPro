{
  "name": "pawnpro",
  "displayName": "PawnPro",
  "description": "%text.description%",
  "version": "3.5.0",
  "publisher": "NullSablex",
  "type": "module",
  "license": "SEE LICENSE IN LICENSE.md",
  "engines": {
    "vscode": "^1.106.0"
  },
  "platforms": [
    "linux-x64",
    "linux-arm64",
    "win32-x64",
    "darwin-x64",
    "darwin-arm64"
  ],
  "categories": [
    "Programming Languages",
    "Linters"
  ],
  "keywords": [
    "pawn",
    "sa-mp",
    "samp",
    "gta",
    "pwn",
    "server",
    "rcon"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "bugs": {
    "url": "https://github.com/NullSablex/PawnPro/issues"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/NullSablex/PawnPro"
  },
  "icon": "images/logo.png",
  "engineVersion": "1.4.0",
  "engineRepository": "https://github.com/NullSablex/PawnPro-Engine",
  "debuggerVersion": "0.2.0",
  "debuggerRepository": "https://github.com/NullSablex/PawnPro-Debugger",
  "author": {
    "name": "NullSablex",
    "url": "https://github.com/NullSablex"
  },
  "main": "./out/editor/extension.js",
  "l10n": "./l10n",
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "pawnpro",
          "title": "PawnPro",
          "icon": "images/icon.svg"
        }
      ]
    },
    "views": {
      "pawnpro": [
        {
          "id": "pawnpro.includesView",
          "name": "Includes",
          "icon": "symbol-method"
        },
        {
          "id": "pawnpro.serverView",
          "name": "Servidor",
          "icon": "symbol-method",
          "type": "webview"
        }
      ]
    },
    "keybindings": [
      {
        "command": "pawnpro.compileCurrent",
        "key": "ctrl+alt+b",
        "when": "editorLangId == pawn && editorTextFocus"
      },
      {
        "command": "editor.action.formatSelection",
        "key": "ctrl+k ctrl+f",
        "when": "editorLangId == pawn && editorTextFocus && editorHasSelection && !editorReadonly"
      }
    ],
    "snippets": [
      {
        "language": "pawn",
        "path": "./snippets/pawn.json"
      }
    ],
    "grammars": [
      {
        "language": "pawn",
        "scopeName": "source.pawn",
        "path": "./syntaxes/pawn.tmLanguage.json"
      },
      {
        "language": "pawnpro-namelist",
        "scopeName": "source.pawnpro-namelist",
        "path": "./syntaxes/namelist.tmLanguage.json"
      },
      {
        "language": "toml",
        "scopeName": "source.toml",
        "path": "./syntaxes/toml.tmLanguage.json"
      }
    ],
    "semanticTokenScopes": [
      {
        "language": "pawn",
        "scopes": {
          "function": [
            "support.function.pawn"
          ]
        }
      },
      {
        "scopes": {
          "tomlArrayKey": [
            "support.type.property-name.array.toml"
          ],
          "tomlTableKey": [
            "support.type.property-name.table.toml"
          ]
        }
      }
    ],
    "languages": [
      {
        "id": "pawn",
        "aliases": [
          "PAWN",
          "pawn"
        ],
        "extensions": [
          ".pwn",
          ".inc",
          ".p",
          ".pawn"
        ],
        "configuration": "./language-configuration.json"
      },
      {
        "id": "pawnpro-namelist",
        "aliases": [
          "PawnPro Name List"
        ],
        "extensions": [
          ".ban",
          ".allow"
        ],
        "configuration": "./namelist-language-configuration.json"
      },
      {
        "id": "toml",
        "aliases": [
          "TOML"
        ],
        "extensions": [
          ".toml"
        ],
        "filenames": [
          "package.lock"
        ],
        "configuration": "./toml-language-configuration.json"
      }
    ],
    "commands": [
      {
        "command": "pawnpro.compileCurrent",
        "title": "%command.compile%"
      },
      {
        "command": "pawnpro.detectCompiler",
        "title": "%command.detect%"
      },
      {
        "command": "pawnpro.applySyntaxScheme",
        "title": "%command.applySyntaxScheme%"
      },
      {
        "command": "pawnpro.resetSyntaxScheme",
        "title": "%command.resetSyntaxScheme%"
      },
      {
        "command": "pawnpro.server.start",
        "title": "%command.server.start%",
        "icon": "$(debug-start)"
      },
      {
        "command": "pawnpro.server.stop",
        "title": "%command.server.stop%",
        "icon": "$(debug-stop)"
      },
      {
        "command": "pawnpro.server.restart",
        "title": "%command.server.restart%",
        "icon": "$(debug-restart)"
      },
      {
        "command": "pawnpro.server.show",
        "title": "%command.server.show%",
        "icon": "$(terminal)"
      },
      {
        "command": "pawnpro.server.showLog",
        "title": "%command.server.showLog%",
        "icon": "$(output)"
      },
      {
        "command": "pawnpro.clearEngineCache",
        "title": "%command.clearEngineCache%"
      },
      {
        "command": "pawnpro.recoverConfig",
        "title": "%command.recoverConfig%"
      },
      {
        "command": "pawnpro.whatsNew",
        "title": "%command.whatsNew%"
      },
      {
        "command": "pawnpro.help",
        "title": "%command.help%"
      },
      {
        "command": "pawnpro.newScript",
        "title": "%command.newScript%"
      },
      {
        "command": "pawnpro.openSettings",
        "title": "%command.openSettings%"
      },
      {
        "command": "pawnpro.openStore",
        "title": "%command.openStore%"
      }
    ],
    "configurationDefaults": {
      "[pawn]": {
        "files.encoding": "windows1252"
      }
    },
    "breakpoints": [
      {
        "language": "pawn"
      }
    ],
    "debuggers": [
      {
        "type": "pawn",
        "label": "PawnPro Debugger",
        "languages": [
          "pawn"
        ],
        "configurationAttributes": {
          "launch": {
            "required": [
              "program"
            ],
            "properties": {
              "program": {
                "type": "string",
                "description": "%debug.program%",
                "default": "${workspaceFolder}/gamemodes/${command:AskForProgramName}.amx"
              },
              "server": {
                "type": "string",
                "description": "%debug.server%"
              },
              "cwd": {
                "type": "string",
                "description": "%debug.cwd%",
                "default": "${workspaceFolder}"
              },
              "session": {
                "type": "string",
                "description": "%debug.session%"
              },
              "stopOnEntry": {
                "type": "boolean",
                "description": "%debug.stopOnEntry%",
                "default": false
              }
            }
          }
        },
        "initialConfigurations": [
          {
            "type": "pawn",
            "request": "launch",
            "name": "Depurar script Pawn (PawnPro)",
            "program": "${workspaceFolder}/gamemodes/main.amx",
            "cwd": "${workspaceFolder}"
          }
        ],
        "configurationSnippets": [
          {
            "label": "PawnPro: Depurar script Pawn",
            "description": "Depura um script Pawn (gamemode, filterscript ou outro .amx) no servidor local, compilado com -d3.",
            "body": {
              "type": "pawn",
              "request": "launch",
              "name": "Depurar script Pawn (PawnPro)",
              "program": "^\"\\${workspaceFolder}/gamemodes/main.amx\"",
              "cwd": "^\"\\${workspaceFolder}\""
            }
          }
        ]
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "pawnpro.server.start",
          "when": "view == pawnpro.serverView && !pawnpro.server.running",
          "group": "navigation"
        },
        {
          "command": "pawnpro.server.stop",
          "when": "view == pawnpro.serverView && pawnpro.server.running",
          "group": "navigation"
        },
        {
          "command": "pawnpro.server.restart",
          "when": "view == pawnpro.serverView && pawnpro.server.running",
          "group": "navigation@1"
        },
        {
          "command": "pawnpro.server.show",
          "when": "view == pawnpro.serverView",
          "group": "navigation@2"
        },
        {
          "command": "pawnpro.server.showLog",
          "when": "view == pawnpro.serverView && pawnpro.server.running",
          "group": "navigation@3"
        },
        {
          "command": "pawnpro.server.start",
          "when": "view == pawnpro.serverView.explorer && !pawnpro.server.running",
          "group": "navigation"
        },
        {
          "command": "pawnpro.server.stop",
          "when": "view == pawnpro.serverView.explorer && pawnpro.server.running",
          "group": "navigation"
        },
        {
          "command": "pawnpro.server.restart",
          "when": "view == pawnpro.serverView.explorer && pawnpro.server.running",
          "group": "navigation@1"
        },
        {
          "command": "pawnpro.server.show",
          "when": "view == pawnpro.serverView.explorer",
          "group": "navigation@2"
        },
        {
          "command": "pawnpro.server.showLog",
          "when": "view == pawnpro.serverView.explorer && pawnpro.server.running",
          "group": "navigation@3"
        }
      ],
      "commandPalette": [
        {
          "command": "pawnpro.server.start",
          "when": "true"
        },
        {
          "command": "pawnpro.server.stop",
          "when": "true"
        },
        {
          "command": "pawnpro.server.restart",
          "when": "true"
        },
        {
          "command": "pawnpro.server.show",
          "when": "true"
        },
        {
          "command": "pawnpro.server.showLog",
          "when": "true"
        }
      ]
    }
  },
  "scripts": {
    "compile": "tsc --noEmit -p .",
    "bundle": "node scripts/bundle.mjs",
    "bundle:dev": "node scripts/bundle.mjs --dev",
    "vscode:prepublish": "npm run bundle",
    "watch": "node scripts/bundle.mjs --watch",
    "package": "npm run package:full",
    "package:full": "npm run bundle && npx @vscode/vsce package --no-dependencies --no-yarn && node scripts/repack-vsix.js",
    "package:pre": "npm run bundle && npx @vscode/vsce package --pre-release --no-dependencies --no-yarn && node scripts/repack-vsix.js"
  },
  "devDependencies": {
    "@types/node": "^26.4.0",
    "@types/vscode": "1.106.0",
    "@vscode/l10n-dev": "^0.0.35",
    "@vscode/vsce": "^3.9.2",
    "esbuild": "^0.28.2",
    "jszip": "^3.10.1",
    "typescript": "^7.0.2"
  },
  "dependencies": {
    "iconv-lite": "^0.7.3",
    "vscode-languageclient": "^10.1.1"
  },
  "overrides": {
    "minimatch": "10.2.3",
    "qs": "6.15.2",
    "ajv": "8.18.0",
    "markdown-it": "14.2.0",
    "underscore": "1.13.8"
  },
  "engineChecksums": {
    "pawnpro-engine-linux-x64": "d5abca0556a7ee3258e235d170aa090bf02a101056c603ebeb06bd9c47030737",
    "pawnpro-engine-linux-arm64": "237728d0efbac0efc260f6da9bb43780c0ca81642f6e9a82ab0ab2cd404e1324",
    "pawnpro-engine-win32-x64.exe": "8dd439f18dcc6deadd508a438553379f16f2790e970964810ae4cc7929f35345",
    "pawnpro-engine-darwin-x64": "d5ad4c9261b413f4866065e1c52b1d8018225d80b26686dcd1bc3b295a53f6bc",
    "pawnpro-engine-darwin-arm64": "99c7d59cc70dd6274354ef68afb088e0389d8b7a65d7255caa8f47f16f46b3cd"
  },
  "debuggerChecksums": {
    "pawnpro-dap-adapter-linux-x64": "494bfc9eb5e725f877ae956ba45912fb6bd2b151ece78b3299d25f1ec0723a7f",
    "pawnpro-dap-adapter-linux-arm64": "a93b3cdd97015b8fec3d8d90bb64429a472566175c71e5dd69cb6b42acff2c19",
    "pawnpro-dap-adapter-win32-x64.exe": "0d41d41dcc156d2f1dadba289e2eab6df8a31a7fc6135adc596d5e6a409dfadc",
    "pawnpro-dap-adapter-darwin-x64": "4cacdbc45c286f03a77c70c4d9cbb988743d633d4e61c1af4658087c46dfc95f",
    "pawnpro-dap-adapter-darwin-arm64": "d44963efc3efb56057e7fc79f1df0293be79657b7e06418a40883b48de527eac"
  }
}
